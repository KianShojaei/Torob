# ---------------------------------------------------------------------------
# Torbgard — environment contract (master prompt §7)
# Copy to .env. Everything has a safe default; the app runs with this file absent.
# ---------------------------------------------------------------------------

# --- data ------------------------------------------------------------------
# DATA_DIR=./data
# DB_PATH=./backend/var/app.db
SNAPSHOT_DATE=2026-10-13

# --- LLM (provider agnostic) ----------------------------------------------
# none | anthropic | openai        "none" = deterministic agent, no key needed
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# for any OpenAI-compatible gateway:
# LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# --- demo behaviour --------------------------------------------------------
DEMO_MODE=true
# 1 simulated minute = 60/DEMO_TIME_SCALE real seconds (20 => 3s)
DEMO_TIME_SCALE=20
# how long we wait for a seller before offering alternatives (real seconds)
CONTACT_TIMEOUT_SECONDS=45
# share of sellers that never answer (demo realism)
NO_REPLY_RATE=0.33

# --- geo / map -------------------------------------------------------------
DEFAULT_LAT=35.6949
DEFAULT_LON=51.4071
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- web -------------------------------------------------------------------
CORS_ORIGINS=*
LOG_LEVEL=INFO

# Fixed clock for open/arrival calculations (demo only). Empty = real time.
# DEMO_NOW=2026-10-21T17:30:00+03:30
