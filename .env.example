# ---------------------------------------------------------------------------
# Torbgard — environment contract (master prompt §7)
# Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- LLM (provider agnostic) ----------------------------------------------
# none | anthropic | openai   (none = deterministic rule-based agent, always works)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# For OpenAI-compatible gateways (Iranian providers, OpenRouter, proxies):
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# --- data ----------------------------------------------------------------
DATA_DIR=./data
DB_PATH=./backend/var/app.db
# dataset snapshot date; drives every "price age" label
SNAPSHOT_DATE=2026-10-13

# --- demo / seller simulation --------------------------------------------
DEMO_MODE=true
# 1 simulated minute = 60/scale real seconds (20 => 3 s)
DEMO_TIME_SCALE=20
CONTACT_TIMEOUT_SECONDS=45
NO_REPLY_RATE=0.33

# --- geo ------------------------------------------------------------------
DEFAULT_LAT=35.6949
DEFAULT_LON=51.4071
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- web ------------------------------------------------------------------
CORS_ORIGINS=*
LOG_LEVEL=INFO
